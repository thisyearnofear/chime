# CHIME Environment Variables
# Copy to .env.local

# Canonical URL for metadata / OG (set this on Netlify)
# NEXT_PUBLIC_BASE_URL=https://chimeapp.netlify.app

# Somnia Network: testnet | mainnet
NEXT_PUBLIC_NETWORK=testnet

# Optional venue override if DreamDEX rotates venue IDs
# NEXT_PUBLIC_VENUE_ID=0x...

# LLM (optional — floor falls back to heuristic takes)
VENICE_API_KEY=
FEATHERLESS_API_KEY=
